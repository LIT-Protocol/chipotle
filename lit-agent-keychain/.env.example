DATABASE_URL=postgres://localhost/keychain
PUBLIC_BASE_URL=http://localhost:8000
LIT_API_URL=https://api.chipotle.litprotocol.com
LIT_NETWORK=chipotle-v1
# Server-held execution-only usage key with executeInGroups=[0] on a funded Lit account.
LIT_EXECUTION_KEY=
# Dedicated managed Chipotle parent account; never sent to clients.
CHIPOTLE_MASTER_API_KEY=
# Generate with openssl rand -hex 32. Persist securely with database backups.
USAGE_KEY_ENCRYPTION_KEY=
# Standard subscription, separate from any Stripe credential stored in a vault.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
CONTACT_EMAIL=support@litprotocol.com
# The counters below limit server-sponsored login attempts, not direct user execution.
# Optional: enable Google-only sign-in. Register PUBLIC_BASE_URL as an authorized JS origin.
GOOGLE_CLIENT_ID=
DAILY_EXECUTION_LIMIT=10000
HOURLY_IP_EXECUTION_LIMIT=200
DAILY_VAULT_EXECUTION_LIMIT=1000
# Client trust anchor, compiled into the client (set at npm/Docker build time).
VITE_LIT_API_URL=https://api.chipotle.litprotocol.com
# Optional: WalletConnect/RainbowKit project ID. Injected wallets work without it.
VITE_WALLETCONNECT_PROJECT_ID=
