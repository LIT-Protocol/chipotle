{
  "v": 1,
  "id": "openai_chat",
  "kind": "use",
  "name": "OpenAI chat completion",
  "description": "Sends the agent's messages to OpenAI chat completions with the stored API key and returns only the assistant text, finish reason and token usage. The key never leaves the enclave.",
  "category": "ai",
  "author": "Lit Protocol",
  "license": "Apache-2.0",
  "operation": "openai.chat",
  "credentialPattern": "^sk-[A-Za-z0-9_-]{20,256}$",
  "allowedHosts": ["api.openai.com"],
  "input": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$",
        "description": "OpenAI model id, for example gpt-4o-mini"
      },
      "messages": {
        "type": "array",
        "maxItems": 32,
        "description": "Conversation so far, oldest first",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "maxLength": 9,
              "enum": ["system", "user", "assistant"]
            },
            "content": { "type": "string", "maxLength": 4096 }
          },
          "required": ["role", "content"]
        }
      },
      "maxTokens": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096,
        "description": "Completion token cap; defaults to 1024"
      }
    },
    "required": ["model", "messages"]
  },
  "output": {
    "type": "object",
    "properties": {
      "content": { "type": "string", "maxLength": 12288 },
      "finishReason": { "type": "string", "maxLength": 32 },
      "model": { "type": "string", "maxLength": 64 },
      "usage": {
        "type": "object",
        "properties": {
          "promptTokens": { "type": "integer", "minimum": 0 },
          "completionTokens": { "type": "integer", "minimum": 0 }
        },
        "required": ["promptTokens", "completionTokens"]
      }
    },
    "required": ["content", "finishReason", "model", "usage"]
  },
  "limits": {
    "timeoutMs": 30000,
    "maxResponseBytes": 262144,
    "maxRequests": 1
  },
  "ui": {
    "label": "Run OpenAI chat completions inside Lit",
    "hint": "Agents send prompts and get the assistant reply. They never see the API key, and the action can reach only api.openai.com.",
    "placeholder": "OPENAI_API_KEY"
  },
  "tier": "verified",
  "deprecated": false
}
