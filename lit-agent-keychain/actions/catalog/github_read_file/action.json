{
  "v": 1,
  "id": "github_read_file",
  "kind": "use",
  "name": "Read a GitHub file",
  "description": "Fetches one file from a repository through the GitHub contents API using the stored token and returns its decoded text, size and blob SHA. Useful for private repositories without handing the token to the agent.",
  "category": "developer",
  "author": "Lit Protocol",
  "license": "Apache-2.0",
  "operation": "github.read_file",
  "credentialPattern": "^(?:ghp_[A-Za-z0-9]{36,255}|github_pat_[A-Za-z0-9_]{60,255}|ghs_[A-Za-z0-9]{36,255})$",
  "allowedHosts": ["api.github.com"],
  "input": {
    "type": "object",
    "properties": {
      "owner": {
        "type": "string",
        "maxLength": 39,
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
      },
      "repo": {
        "type": "string",
        "maxLength": 100,
        "pattern": "^[A-Za-z0-9_.-]{1,100}$"
      },
      "path": {
        "type": "string",
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\s?#]{1,512}$",
        "description": "Path inside the repository, no leading slash"
      },
      "ref": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_./-]{1,128}$",
        "description": "Branch, tag or commit; defaults to the repository default branch"
      }
    },
    "required": ["owner", "repo", "path"]
  },
  "output": {
    "type": "object",
    "properties": {
      "path": { "type": "string", "maxLength": 512 },
      "sha": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[0-9a-f]{40,64}$"
      },
      "size": { "type": "integer", "minimum": 0 },
      "content": { "type": "string", "maxLength": 14336 },
      "truncated": { "type": "boolean" }
    },
    "required": ["path", "sha", "size", "content", "truncated"]
  },
  "limits": {
    "timeoutMs": 10000,
    "maxResponseBytes": 1048576,
    "maxRequests": 1
  },
  "ui": {
    "label": "Read repository files inside Lit",
    "hint": "Agents can read files from repositories the token can see. The token itself is never revealed and the action reaches only api.github.com.",
    "placeholder": "GITHUB_TOKEN"
  },
  "tier": "verified",
  "deprecated": false
}
