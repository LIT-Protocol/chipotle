{
  "openapi": "3.1.0",
  "info": {
    "title": "Chipotle dashboard password storage",
    "version": "1.0.0",
    "description": "New accounts only. No password recovery, key import, or legacy enrollment. Browser encrypts the API key; this service never receives the encryption key or password."
