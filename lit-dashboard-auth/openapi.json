            "required": true,
            "schema": {
              "const": "1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; session bootstrap responses contain parameters, email, state, operation, envelope and csrf. Login/verification also set a Secure HttpOnly cookie."
