  },
  "dependencies": {
    "@reown/walletkit": "^1.1.0",
    "@walletconnect/core": "^2.17.0",
    "@walletconnect/utils": "^2.17.0",
    "ethers": "^6.13.0",
    "viem": "^2.21.0"
  }
