# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_action that revert NotMasterAccount on scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com (saved when the
# account was created — if you've lost it, you'll need a new account).
LIT_API_KEY=

# Alchemy Base-Sepolia RPC URL. The policy action enforces a hostname
# whitelist requiring base-sepolia.g.alchemy.com — public RPCs won't pass.
# This URL is reused for the action's on-chain reads AND as the network RPC
# for deploys/transactions. Get a free Alchemy app at
# https://dashboard.alchemy.com. The URL looks like:
#   https://base-sepolia.g.alchemy.com/v2/<your-api-key>
ALCHEMY_BASE_SEPOLIA_URL=

# EOA that deploys the contracts and acts as the vault OWNER. Needs Base-Sepolia
# gas. The owner is FULLY TRUSTED — it can change policy (cap, kill switch,
# allowlist) and sweep the vault to COLD_WALLET (the only thing it can't do
# quickly is change the exit destination — that's timelocked). Treat it like a
# treasury key; use a Safe in production. The solver BOT never holds this key.
DEPLOYER_PRIVATE_KEY=

# EOA the solver bot uses to submit fill txs (the front-runnable, throwaway
# gas account). In this demo it can be the same as DEPLOYER_PRIVATE_KEY.
# This key holds NO inventory and cannot authorize a fill on its own.
SOLVER_PRIVATE_KEY=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com

# Pinned emergency-exit destination. In production this should be a Safe
# multisig you already control — see the README "Liveness & exit" section.
# Defaults to the deployer address if left blank (set by setup.js).
COLD_WALLET=

# Per-fill notional cap, in whole MockUSDC (6 decimals applied by scripts).
MAX_FILL_USDC=1000

# Demo recipient for the sample order (the address a legit fill pays out to).
# Defaults to the deployer address if left blank (set by setup.js).
ORDER_RECIPIENT=

# Where attack-exfiltrate.js tries to redirect funds. Any address you don't
# control works to make the point; defaults below to the canonical burn-ish
# test address.
ATTACKER_ADDRESS=0x000000000000000000000000000000000000dEaD


# ===========================================================================
# Auto-filled by `npm run setup` — leave blank, the script will populate them
# ===========================================================================

# IPFS CID of action/solverPolicy.js.
ACTION_IPFS_CID=

# Wallet address derived from the action's IPFS CID. The deployed SolverVault
# pins this as its policy signer — the only key whose signature releases a
# fill. Edit the action by a byte and this address changes.
POLICY_SIGNER_ADDRESS=

# Permission group + scoped usage key. fill.js / the attack scripts use the
# usage key for /lit_action — the master LIT_API_KEY can't execute actions
# in your own groups.
# Heads up: the usage key is shown ONCE by the server. Re-running setup mints
# a fresh key and overwrites this line.
GROUP_ID=
LIT_USAGE_API_KEY=

# Deployed contract addresses.
MOCK_USDC_ADDRESS=
MOCK_SETTLEMENT_ADDRESS=
SOLVER_VAULT_ADDRESS=

# Sample order id posted to the MockSettlement by setup.js (the happy-path
# fill references this).
SAMPLE_DEPOSIT_ID=


# ===========================================================================
# ACROSS TESTNET INTEGRATION (optional — the real-fill variant)
# ===========================================================================
# Run `npm run across:setup` then across:deposit / across:fill / across:attack.
# Route: Sepolia (origin) -> Base Sepolia (destination), WETH both sides.

# Origin (Sepolia) Alchemy RPC URL, of the form
#   https://eth-sepolia.g.alchemy.com/v2/<your-api-key>
# The acrossPolicy action whitelists eth-sepolia.g.alchemy.com to read the
# deposit. Your DEPLOYER_PRIVATE_KEY needs a little Sepolia ETH (to wrap +
# deposit) on top of its Base-Sepolia gas.
ALCHEMY_ETH_SEPOLIA_URL=

# Demo amounts (whole ETH/WETH, 18 decimals). Keep them small — testnet ETH.
ACROSS_INVENTORY_ETH=0.01    # WETH moved into the vault as fill inventory
ACROSS_MAX_FILL_ETH=0.005    # per-fill cap enforced by the policy action
ACROSS_DEPOSIT_ETH=0.001     # input amount of the sample deposit

# --- Auto-filled by `npm run across:setup` / across:deposit — leave blank ---
ACROSS_ACTION_IPFS_CID=
ACROSS_POLICY_SIGNER_ADDRESS=
ACROSS_GROUP_ID=
ACROSS_USAGE_API_KEY=
ACROSS_VAULT_ADDRESS=
ACROSS_DEPOSIT_ID=
ACROSS_DEPOSIT_BLOCK=

# --- Override only if Across redeploys its testnet contracts ---
# ACROSS_ORIGIN_CHAIN_ID=11155111
# ACROSS_DEST_CHAIN_ID=84532
# ACROSS_ORIGIN_SPOKE=0x5ef6C01E11889d86803e0B23e3cB3F9E9d97B662
# ACROSS_DEST_SPOKE=0x82B564983aE7274c86695917BBf8C99ECb6F0F8F
# ACROSS_ORIGIN_WETH=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
# ACROSS_DEST_WETH=0x4200000000000000000000000000000000000006
