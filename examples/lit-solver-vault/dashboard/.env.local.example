# Copy to .env.local. The dashboard reads the vault on the destination chain
# (Base Sepolia). Easiest: paste the same values from the example's .env.

# Destination-chain RPC the dashboard reads through (server-side only).
ALCHEMY_BASE_SEPOLIA_URL=

# The AcrossSolverVault to display — copy ACROSS_VAULT_ADDRESS from ../​.env
VAULT_ADDRESS=

# Owner key, used ONLY by the /api/killswitch route to flip the kill switch.
# Stays server-side; never shipped to the browser. Omit to make the dashboard
# fully read-only (the toggle will return an error).
OWNER_PRIVATE_KEY=

# The kill-switch route has NO authentication. It is disabled by default.
# Set this to "true" ONLY when the dashboard is bound to localhost or a trusted
# network — anyone who can reach the route can flip the kill switch with the
# owner key. Put real auth in front before exposing it publicly.
DASHBOARD_ENABLE_WRITES=false

# Inventory token shown as the vault balance (Base Sepolia WETH by default).
TOKEN_ADDRESS=0x4200000000000000000000000000000000000006

# How many blocks back to scan for fill events (Base Sepolia ~2s blocks).
FILL_LOOKBACK_BLOCKS=50000
