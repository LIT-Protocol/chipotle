# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_action that revert NotMasterAccount on scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# Required — web-grounded baseline model. Perplexity Sonar runs a live
# web search behind every prompt, so it can answer questions about
# events that happened after a frontier model's training cutoff.
# Get a key at https://www.perplexity.ai/api-platform.
PERPLEXITY_API_KEY=

# EOA used to deploy the PredictionMarket registry. Needs gas on
# whatever chain you're targeting (Base Sepolia by default).
DEPLOYER_PRIVATE_KEY=

# EOA used by propose.js to write questions on-chain. Typically the
# same as DEPLOYER_PRIVATE_KEY for testing.
PROPOSER_PRIVATE_KEY=

# EOA used by resolve.js to write signed resolutions on-chain. Typically
# the same as DEPLOYER_PRIVATE_KEY for testing.
RESOLVER_PRIVATE_KEY=


# ===========================================================================
# OPTIONAL — configure for stronger consensus
# ===========================================================================

# Frontier-model second opinion. With this set, the action requires
# Perplexity AND OpenAI to return the same answer before signing.
# Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Frontier-model second opinion. With this set, the action requires
# Anthropic to also agree. Configure all three (Perplexity + OpenAI +
# Anthropic) for full 3-of-3 consensus.
# Get a key at https://console.anthropic.com/account/keys.
ANTHROPIC_API_KEY=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com

# Hardhat networks for the deploy step
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Where propose.js / resolve.js talk to the PredictionMarket — should
# match wherever you deployed it.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org


# ===========================================================================
# Auto-filled by `npm run setup` — leave blank, the script will populate them
# ===========================================================================

# PKP used as the encryption boundary for the AI provider keys. Lit's
# Encrypt/Decrypt is PKP-keyed, so we need somewhere for the ciphertexts
# to live that only this action's TEE can decrypt.
DECRYPT_PKP_ADDRESS=

# Wallet address derived from the action's IPFS CID. The deployed
# PredictionMarket pins this as its oracle.
ACTION_WALLET_ADDRESS=

# Scoped usage key with execute permission for this example's group.
# resolve.js + the encrypt-helper inside setup both use this for
# /lit_action.
# Heads up: shown ONCE by the server. Re-running setup mints a fresh key
# and overwrites this line.
LIT_USAGE_API_KEY=

# Encrypted ciphertexts for the AI provider keys above. Setup encrypts
# whichever plaintext keys are present and writes the ciphertexts here.
ENCRYPTED_PERPLEXITY_API_KEY=
ENCRYPTED_OPENAI_API_KEY=
ENCRYPTED_ANTHROPIC_API_KEY=

# Deployed PredictionMarket contract address.
PREDICTION_MARKET_ADDRESS=
