# Lit Chipotle ---------------------------------------------------------------
LIT_API_BASE=https://api.chipotle.litprotocol.com

# Your ACCOUNT-LEVEL (master) API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_action that revert NotMasterAccount on scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# Scoped usage key — auto-generated by setup.js with execute permission
# for this example's group. encryptApiKeys.js (during setup) and
# resolve.js (after setup) both use this for /lit_action.
# Heads up: shown ONCE by the server. Delete it from .env and setup
# will create a fresh one.
LIT_USAGE_API_KEY=

# Filled in by setup.js
DECRYPT_PKP_ADDRESS=
ACTION_WALLET_ADDRESS=

# AI providers ---------------------------------------------------------------
# Perplexity is REQUIRED. Its Sonar models index the web at query time, so
# they can answer questions about events that happened after a frontier
# model's training cutoff — the right baseline for prediction-market style
# questions about real-world events.
PERPLEXITY_API_KEY=

# OpenAI and Anthropic are OPTIONAL "second opinion" models. Configuring
# both means the action only signs when all three return the same answer,
# which is much stronger than any single model. If you skip them the
# action runs Perplexity-only and the signed resolution carries a single
# vote — usable for low-stakes demos, weak for real money.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Filled in by setup.js
ENCRYPTED_PERPLEXITY_API_KEY=
ENCRYPTED_OPENAI_API_KEY=
ENCRYPTED_ANTHROPIC_API_KEY=

# Contract deploy / interaction ----------------------------------------------
DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Filled in by setup.js
PREDICTION_MARKET_ADDRESS=
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# Used by propose.js / resolve.js
PROPOSER_PRIVATE_KEY=
RESOLVER_PRIVATE_KEY=
