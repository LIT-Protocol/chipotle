# ===========================================================================
# REQUIRED — fill this in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_group and /add_action that reject scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# Where alerts go. The email is sent by the Lit runtime's server-mediated
# sendEmail op (fixed from-domain, per-account quota, plain text only).
# Leave empty to run the monitor in report-only mode.
ALERT_EMAIL=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com

# Hyperliquid coins to monitor, comma-separated. Case-sensitive (e.g. kPEPE).
# The action caps this at 4 coins = 8 outbound fetches per run.
COINS=BTC,ETH

# Alert when |annualized funding %| exceeds this. Hyperliquid funding accrues
# hourly; annualized % = hourly rate x 24 x 365 x 100.
THRESHOLD_PCT=20

# true -> read funding from the Hyperliquid testnet instead of mainnet
# (useful if mainnet geo-blocks your environment's egress region).
HL_SANDBOX=false


# ===========================================================================
# Auto-filled by `npm run setup` — leave blank, the script populates them
# ===========================================================================

# IPFS CID of bundle+action — the ONLY code the usage key may execute
# (pinned, because this action can spend your email quota).
ACTION_IPFS_CID=

# Scoped usage key with execute permission for this example's group.
# Heads up: shown ONCE by the server. Re-running setup mints a fresh key
# and overwrites this line.
GROUP_ID=
LIT_USAGE_API_KEY=
