# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_group and /add_action that reject scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# Binance SPOT TESTNET API key + secret (default venue, VENUE_SANDBOX=true).
# Create them at https://testnet.binance.vision (log in with GitHub) — the
# testnet account comes pre-funded with play balances.
VENUE_API_KEY=
VENUE_SECRET=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com

# Venue: binance | binanceus | coinbase | hyperliquid (see README for the
# hyperliquid/PKP option and the coinbase market-buy caveat).
VENUE_ID=binance
VENUE_SANDBOX=true
# binance: hmac (default) or ed25519. coinbase: es256-jwt.
VENUE_KEY_TYPE=hmac
# hyperliquid only (keyType pkp-eip712): either a raw hex key, or set
# VENUE_USE_ACTION_KEY=true to trade with the action's own CID-bound TEE key.
VENUE_PRIVATE_KEY=
VENUE_ACCOUNT_ADDRESS=
VENUE_USE_ACTION_KEY=
# Optional egress proxy http(s)://user:pass@host:port (plan D4) — needed for
# binance.com mainnet from US egress; the spot testnet works without it.
VENUE_PROXY_URL=

# --- TWAP strategy (sizes/prices are DECIMAL STRINGS — never floats) -------
SYMBOL=BTC/USDT
SIDE=buy
# Total base amount, split into SLICES child orders (one per tick).
TOTAL_AMOUNT=0.0004
SLICES=4
# POLICY: hard ceiling on per-slice notional (quote units, e.g. USDT).
MAX_SLICE_NOTIONAL=25
# POLICY: abort a slice if price drifts more than this many bps (either
# direction) from the FIRST tick's reference price.
MAX_DRIFT_BPS=100
# market (default) or limit (aggressive IOC limit priced through the touch).
ORDER_TYPE=market
# Expiry fence: give up after this many ticks (default SLICES*5).
MAX_TICKS=
# true = evaluate every fence but place nothing.
DRY_RUN=false


# ===========================================================================
# Auto-filled by `npm run setup` — leave blank, the script will populate them
# ===========================================================================

# Scoped usage key with execute permission for this example's group.
# Heads up: shown ONCE by the server. Re-running setup mints a fresh key
# and overwrites this line.
LIT_USAGE_API_KEY=

# Group + composed-action CID + per-run TWAP id — bookkeeping from setup.js.
GROUP_ID=
ACTION_IPFS_CID=
TWAP_ID=
