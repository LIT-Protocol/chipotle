# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_action that revert NotMasterAccount on scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com
LIT_API_KEY=

# Alchemy Base-Sepolia RPC URL. The policy action enforces a hostname whitelist
# requiring base-sepolia.g.alchemy.com — public RPCs won't pass. This URL is
# reused for the action's on-chain reads AND as the network RPC for deploys
# /transactions. Get a free app at https://dashboard.alchemy.com. Looks like:
#   https://base-sepolia.g.alchemy.com/v2/<your-api-key>
# (We deploy our own GPv2Settlement, so any EVM chain works; Base Sepolia is
# fast + cheap. To use another chain, set COW_CHAIN_ID and edit the host
# whitelist in action/cowPolicy.js.)
ALCHEMY_BASE_SEPOLIA_URL=

# EOA that deploys everything and becomes the vault OWNER. Needs Base-Sepolia gas.
# The owner is FULLY TRUSTED — it can change policy (cap, kill switch) and sweep
# the vault to COLD_WALLET (the only thing it can't do quickly is change the
# exit destination — that's timelocked). Treat it like a treasury key; use a
# Safe in production. The solver BOT never holds this key.
DEPLOYER_PRIVATE_KEY=

# EOA the solver bot uses to submit the settle tx (the throwaway gas account).
# In this demo it can be the same as DEPLOYER_PRIVATE_KEY. It holds NO inventory
# and is NOT an allowlisted solver — only the vault is — so on its own it can
# neither settle nor authorize a settlement.
SOLVER_PRIVATE_KEY=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com

# Pinned emergency-exit destination. In production this should be a Safe
# multisig you already control. Defaults to the deployer if left blank.
COLD_WALLET=

# The trader (the party whose order gets filled). Defaults to the deployer for a
# self-contained demo; set a distinct key to make the two roles obviously
# separate. Needs no gas unless you give it a distinct address with no balance.
# TRADER_PRIVATE_KEY=

# Demo order + vault sizing (mUSDC has 6 decimals, mWETH 18). The trader sells
# COW_SELL_AMOUNT mUSDC for COW_BUY_AMOUNT mWETH; the vault pays the mWETH from
# inventory. buyAmount must be <= COW_MAX_FILL_WETH (the per-settlement cap) and
# <= COW_INVENTORY_WETH.
COW_SELL_AMOUNT=100
COW_BUY_AMOUNT=0.03
COW_INVENTORY_WETH=0.1
COW_MAX_FILL_WETH=0.05

# Where the order's payout would be redirected in the attack demo. Any address
# you don't control works to make the point.
ATTACKER_ADDRESS=0x000000000000000000000000000000000000dEaD

# Balancer V2 Vault passed to our GPv2Settlement constructor. Never called for
# erc20 orders (payout is a direct transfer); the canonical address is the same
# on every chain. Override only if it differs on your network.
# BALANCER_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8


# ===========================================================================
# Auto-filled by `npm run setup` — leave blank, the scripts populate them
# ===========================================================================

# IPFS CID of action/cowPolicy.js, and the wallet address derived from it. The
# deployed CowSolverVault pins this as its policy signer — the only key whose
# signature lets the vault settle. Edit the action by a byte and it changes.
COW_ACTION_IPFS_CID=
COW_POLICY_SIGNER_ADDRESS=

# Permission group + scoped usage key. solve.js / attack.js use the usage key
# for /lit_action — the master LIT_API_KEY can't execute actions in your groups.
# Heads up: the usage key is shown ONCE by the server; re-running setup mints a
# fresh key and overwrites this line.
COW_GROUP_ID=
COW_USAGE_API_KEY=

# Deployed addresses (our own CoW stack + tokens + vault).
COW_AUTH_ADDRESS=
COW_SETTLEMENT_ADDRESS=
COW_VAULT_RELAYER=
COW_SELL_TOKEN=
COW_BUY_TOKEN=
COW_VAULT_ADDRESS=

# The trader's signed order (JSON), written by `npm run order`.
COW_ORDER=
