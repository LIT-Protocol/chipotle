# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Account-level (master) Lit API key — setup mints the scoped usage key from it.
# https://dashboard.chipotle.litprotocol.com
LIT_API_KEY=

# EOA with Base Sepolia gas. Funds the pool wallet (any public faucet).
DEPLOYER_PRIVATE_KEY=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com
TRIGGERS_BASE=https://triggers.litprotocol.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Statuspage summary.json for the service you're insuring.
STATUS_URL=https://status.anthropic.com/api/v2/summary.json

# Address that gets paid (defaults to the deployer if blank).
POLICYHOLDER=

# Payout per incident (wei) and how much to capitalize the pool with (ETH).
PAYOUT_WEI=200000000000000
POOL_FUND_ETH=0.001

# Cron for the check. Every minute by default so the demo is quick.
CRON=* * * * *

# DEMO: force the "down" branch so a payout reliably fires. Set to false for a
# real policy, where the actual status.indicator drives payouts.
DEMO_FORCE_DOWN=true


# ===========================================================================
# Auto-filled by `npm run setup` — leave blank
# ===========================================================================

LIT_USAGE_API_KEY=
POOL_WALLET_ADDRESS=
LIT_TRIGGERS_AGENT_TOKEN=
ACTION_IPFS_CID=
GROUP_ID=
TRIGGER_ID=
