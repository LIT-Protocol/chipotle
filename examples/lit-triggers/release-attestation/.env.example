# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — not a scoped usage key. Setup calls
# management endpoints (add_group, add_usage_api_key, add_action) that scoped
# keys can't. Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# EOA with gas on Base Sepolia. Used to deploy ReleaseRegistry AND to fund the
# action's wallet (the action broadcasts the attest tx itself, so its wallet
# needs gas). Grab Base Sepolia ETH from any public faucet.
DEPLOYER_PRIVATE_KEY=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com
TRIGGERS_BASE=https://triggers.litprotocol.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# GitHub webhook secret. Leave blank and setup generates one. If you point a
# real GitHub repo webhook at this trigger, use this exact value as the secret.
RELEASE_WEBHOOK_SECRET=

# How much gas to fund the action wallet with during setup.
ACTION_WALLET_GAS_ETH=0.0005


# ===========================================================================
# Auto-filled by `npm run setup` — leave blank
# ===========================================================================

# Scoped usage key minted from LIT_API_KEY; the webhook trigger uses it to
# execute the action. Shown once by the server; re-running setup mints a fresh
# one and overwrites this line.
LIT_USAGE_API_KEY=

# Wallet derived from the action's IPFS CID; pinned as the ReleaseRegistry
# `attester`, and funded with gas so it can broadcast.
ACTION_WALLET_ADDRESS=

# Local bearer token authorized with lit-triggers (browser handshake in setup).
LIT_TRIGGERS_AGENT_TOKEN=

# Bookkeeping written by setup.
ACTION_IPFS_CID=
GROUP_ID=
RELEASE_REGISTRY_BASE_SEPOLIA=
TRIGGER_ID=
WEBHOOK_URL=
