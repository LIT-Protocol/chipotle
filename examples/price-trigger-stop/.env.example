# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_group and /add_action that reject scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# Binance SPOT TESTNET API key + secret (default venue, VENUE_SANDBOX=true).
# Create them at https://testnet.binance.vision (log in with GitHub) — the
# testnet account comes pre-funded with play balances.
VENUE_API_KEY=
VENUE_SECRET=

# --- The stop policy (REQUIRED before poll/arm; decimal strings, no floats).
# Frozen into the trigger at arm time — see README "Trust model".
# Sell when last <= STOP_PRICE ...
STOP_PRICE=
# ... but NEVER below FLOOR_PRICE (gap-down protection; must be <= STOP_PRICE).
FLOOR_PRICE=
# Base amount to sell, and the hard policy ceiling on it.
AMOUNT=0.0002
MAX_AMOUNT=0.0005

# Demo tip: to watch it fire safely RIGHT NOW, set STOP_PRICE above the
# current market price (instant trigger) and keep DRY_RUN=true.


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com
TRIGGERS_BASE=https://triggers.litprotocol.com

# Venue: binance | binanceus | coinbase | hyperliquid.
VENUE_ID=binance
VENUE_SANDBOX=true
# binance: hmac (default) or ed25519. coinbase: es256-jwt.
VENUE_KEY_TYPE=hmac
# hyperliquid only (keyType pkp-eip712): raw hex key, or set
# VENUE_USE_ACTION_KEY=true to sign with the action's CID-bound TEE key
# (master account must approveAgent that address first — see README).
VENUE_PRIVATE_KEY=
VENUE_ACCOUNT_ADDRESS=
VENUE_USE_ACTION_KEY=
# Optional egress proxy http(s)://user:pass@host:port (plan D4) — needed for
# binance.com mainnet from US egress; the spot testnet works without it.
VENUE_PROXY_URL=

SYMBOL=BTC/USDT

# Poller heartbeat: cron for the lit-triggers trigger (npm run arm) and the
# local loop interval (npm run poll). Sub-30s crons are rejected.
CRON=* * * * *
POLL_INTERVAL_SEC=30

# SAFETY DEFAULT: true — the armed/polled action evaluates every fence but
# places nothing. Flip to false deliberately to trade (testnet first).
DRY_RUN=true


# ===========================================================================
# Auto-filled by the scripts — leave blank
# ===========================================================================

# Scoped usage key with execute permission for this example's group (setup.js).
# Heads up: shown ONCE by the server. Re-running setup mints a fresh key
# and overwrites this line.
LIT_USAGE_API_KEY=

# Idempotency seed (setup.js): the stop's clientOrderId is derived from this,
# in both invocation modes, so a double-fire dedupes venue-side.
TRIGGER_ID=

# Group + composed-action CID (setup.js); lit-triggers token + trigger id (arm.js).
GROUP_ID=
ACTION_IPFS_CID=
LIT_TRIGGERS_AGENT_TOKEN=
LT_TRIGGER_ID=
