# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints (add_group, create_wallet, add_action) that reject scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# Configure AT LEAST ONE venue below. Use READ-ONLY API keys: this example
# only ever calls balance endpoints, so grant nothing more at the venue.
# Setup seals whatever you configure into one venue-credentials-v1 ciphertext
# (SEALED_VENUE_CREDENTIALS) that only the pinned action can decrypt, in-TEE.

# --- binance ----------------------------------------------------------------
# BINANCE_KEY_TYPE: hmac (default) or ed25519 (Binance's recommended
# self-generated keys; PKCS8 PEM, hex, or base64 accepted).
# binance.com geo-blocks US egress (HTTP 451) — set EGRESS_PROXY_URL below,
# or BINANCE_SANDBOX=true to use the spot testnet (testnet.binance.vision).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_KEY_TYPE=hmac
BINANCE_SANDBOX=false

# --- coinbase (Advanced Trade, CDP key) --------------------------------------
# COINBASE_API_KEY is the CDP key name (organizations/.../apiKeys/...).
# COINBASE_API_SECRET is the EC P-256 private key PEM — paste it on ONE line
# with literal \n escapes; setup restores the newlines before sealing.
# Advanced Trade has no sandbox; reads run against live.
COINBASE_API_KEY=
COINBASE_API_SECRET=

# --- hyperliquid --------------------------------------------------------------
# Reads need NO key at all — just the account (master) address whose perp
# balance to report. HYPERLIQUID_SANDBOX=true reads the testnet instead.
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_SANDBOX=false


# ===========================================================================
# Optional
# ===========================================================================

# Egress proxy, http(s)://user:pass@host:port. Venue calls then route through
# Lit.Actions.proxiedFetch inside the TEE (plan D4) — needed for binance.com
# from US egress. The URL embeds proxy credentials, so it is sealed too.
EGRESS_PROXY_URL=

LIT_API_BASE=https://api.chipotle.litprotocol.com


# ===========================================================================
# Auto-filled by `npm run setup` — leave blank, the script populates them
# ===========================================================================

# Vault PKP wallet address (= pkpId) the credentials are sealed against.
VAULT_PKP_ADDRESS=

# The venue-credentials-v1 JSON encrypted against the vault PKP. The only
# form of the credentials the runtime path (snapshot.js, cron, CI) ever sees.
SEALED_VENUE_CREDENTIALS=

# IPFS CID of bundle+action — the one code blob permitted to decrypt.
ACTION_IPFS_CID=

# Group binding {vault PKP, pinned CIDs} and the scoped usage key.
# Heads up: the usage key is shown ONCE by the server; re-running setup
# mints a fresh one and overwrites this line.
GROUP_ID=
LIT_USAGE_API_KEY=
