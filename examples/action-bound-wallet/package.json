{
  "name": "action-bound-wallet",
  "version": "0.0.1",
  "private": true,
  "description": "Lit Action example: a unique, immutable wallet per user, bound to the action's code by stamping the user's address into it. No PKP, no contracts to bind.",
  "scripts": {
    "compile": "hardhat compile",
    "setup": "node scripts/setup.js",
    "deploy:baseSepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "address": "node scripts/address.js",
    "deposit": "node scripts/deposit.js",
    "balance": "node scripts/balance.js",
    "withdraw": "node scripts/withdraw.js",
    "attack:wrong-user": "node scripts/attack-wrong-user.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^16.4.5",
    "ethers": "^5.7.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^2.0.2",
    "hardhat": "^2.22.10"
  }
}
