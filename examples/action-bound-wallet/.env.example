# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_group that revert NotMasterAccount on scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# Base-Sepolia RPC URL. Used for the action's nonce/gas reads, contract
# deploys, and broadcasting withdrawals. A public endpoint like
# https://sepolia.base.org works; an Alchemy/Infura URL is more reliable.
RPC_URL=https://sepolia.base.org

# EOA with Base-Sepolia gas. Deploys the DemoToken and funds the demo wallets
# (mints tokens to them + sends a little gas). Get testnet ETH from a
# Base-Sepolia faucet. NOT one of the demo users — keep this key private.
DEPLOYER_PRIVATE_KEY=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com

# Native gas sent to each action-bound wallet on deposit, so it can pay for
# its own withdrawal transaction (the wallet is a plain EOA under the hood).
GAS_TOPUP_ETH=0.001


# ===========================================================================
# Auto-filled by `npm run setup` — leave blank, the script will populate them
# ===========================================================================

# Permission group (wildcard action allowlist) + scoped usage key. The scripts
# use the usage key to run each user's action. The usage key carries NO
# spending power — withdrawals are authorized by the owner's signature, not by
# whoever holds the key.
# Heads up: the usage key is shown ONCE by the server. Re-running setup mints a
# fresh key and overwrites this line.
GROUP_ID=
LIT_USAGE_API_KEY=

# Deployed DemoToken ERC-20 address.
DEMO_TOKEN_ADDRESS=
