# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_action that revert NotMasterAccount on scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# EOA used to deploy BridgeToken on BOTH Base Sepolia and Arbitrum Sepolia,
# and to submit burn / mint txs in bridge.js. Needs gas on both chains —
# grab Sepolia ETH from any public faucet and bridge a little to Arb
# Sepolia (the Arbitrum bridge UI works against Sepolia).
DEPLOYER_PRIVATE_KEY=

# Alchemy RPC URLs for each chain — these are what the Lit Action uses to
# read the burn receipt. The action's RPC_HOSTS whitelist requires hostnames
# `base-sepolia.g.alchemy.com` and `arb-sepolia.g.alchemy.com` respectively;
# public RPCs and other providers won't pass. Get a free Alchemy app at
# https://dashboard.alchemy.com and add Base Sepolia + Arbitrum Sepolia
# networks to it.
BASE_SEPOLIA_ALCHEMY_URL=
ARBITRUM_SEPOLIA_ALCHEMY_URL=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com

# Local provider URLs used by Hardhat to deploy and by bridge.js to submit
# burn/mint txs. These DON'T need to be Alchemy — they can be the public
# free endpoints (and are, by default). The Lit Action uses the Alchemy URLs
# above, which is what the on-chain trust story rests on; these here just
# need to broadcast txs.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Token constructor args. Initial supply is minted only on the
# INITIAL_SUPPLY_NETWORK side; the other chain starts at zero. Tokens get
# there by burning + minting through the bridge.
TOKEN_NAME=Bridge Coin
TOKEN_SYMBOL=BRDG
INITIAL_SUPPLY=1000000
INITIAL_SUPPLY_NETWORK=baseSepolia


# ===========================================================================
# Auto-filled by `npm run setup` — leave blank, the script will populate them
# ===========================================================================

# Wallet address derived from the action's IPFS CID. Both BridgeToken
# deployments pin this as their bridgeOracle.
ACTION_WALLET_ADDRESS=

# Scoped usage key with execute permission for this example's group.
# bridge.js uses this for /lit_action — the master LIT_API_KEY above
# can't execute /lit_action for your own groups.
# Heads up: shown ONCE by the server. Re-running setup mints a fresh key
# and overwrites this line.
LIT_USAGE_API_KEY=

# Deployed BridgeToken addresses per chain.
BRIDGE_TOKEN_BASE_SEPOLIA=
BRIDGE_TOKEN_ARB_SEPOLIA=

# Group, action CID, etc. — filled in by setup.js as bookkeeping.
ACTION_IPFS_CID=
GROUP_ID=
