{
  "name": "multi-source-price-oracle",
  "version": "0.0.1",
  "private": true,
  "description": "Lit Action that fetches a spot price from three independent exchanges, takes the median, and signs it for on-chain consumption.",
  "scripts": {
    "compile": "hardhat compile",
    "setup": "node scripts/setup.js",
    "deploy:baseSepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "deploy:base": "hardhat run scripts/deploy.js --network base",
    "submit": "node scripts/submit.js",
    "test-medianizer": "node scripts/test-medianizer.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^16.4.5",
    "ethers": "^5.7.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^2.0.2",
    "hardhat": "^2.22.10"
  }
}
