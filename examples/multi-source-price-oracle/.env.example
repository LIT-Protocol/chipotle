# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_action that revert NotMasterAccount on scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# EOA used to deploy the PriceOracle registry. Needs gas on whatever
# chain you're targeting (Base Sepolia by default).
DEPLOYER_PRIVATE_KEY=

# EOA used by submit.js to write signed prices on-chain. Typically the
# same as DEPLOYER_PRIVATE_KEY for testing.
SUBMITTER_PRIVATE_KEY=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com

# Hardhat networks for the deploy step
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Where submit.js talks to the PriceOracle — should match wherever you
# deployed it.
REGISTRY_CHAIN_ID=84532
REGISTRY_RPC_URL=https://sepolia.base.org


# ===========================================================================
# Auto-filled by `npm run setup` — leave blank, the script will populate them
# ===========================================================================

# Wallet address derived from the action's IPFS CID. The deployed
# PriceOracle pins this as its signer.
ACTION_WALLET_ADDRESS=

# Scoped usage key with execute permission for this example's group.
# submit.js uses this for /lit_action.
# Heads up: shown ONCE by the server. Re-running setup mints a fresh key
# and overwrites this line.
LIT_USAGE_API_KEY=

# Deployed PriceOracle contract address.
PRICE_ORACLE_ADDRESS=
