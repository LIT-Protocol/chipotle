# Lit Chipotle ---------------------------------------------------------------
LIT_API_BASE=https://api.chipotle.litprotocol.com

# Your ACCOUNT-LEVEL (master) API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_action that revert NotMasterAccount on scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# Filled in by setup.js
ACTION_WALLET_ADDRESS=

# Contract deploy / submit ---------------------------------------------------
DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Filled in by setup.js
PRICE_ORACLE_ADDRESS=
REGISTRY_CHAIN_ID=84532
REGISTRY_RPC_URL=https://sepolia.base.org

# Account that pays gas to submit signed readings on-chain
SUBMITTER_PRIVATE_KEY=
