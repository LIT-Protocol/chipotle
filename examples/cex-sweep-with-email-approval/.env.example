# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_group and /add_action that reject scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# The human who must approve sweeps. They receive the approval LINK by email;
# the one-time code reaches them out-of-band (request-sweep prints it).
APPROVER_EMAIL=

# Binance SPOT TESTNET API key + secret (HMAC). Create them at
# https://testnet.binance.vision (GitHub login -> Generate HMAC_SHA256 Key).
# Testnet accounts come pre-funded with play assets; data resets periodically.
# DEMO ONLY: these travel as js_params. Production seals them with the PKP
# vault (venue-credentials-v1) and decrypts in-TEE — see the README.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# The self-custody address the sweep is destined for. In this demo it is the
# intent shown to the approver (and what production phase 2 would pay to).
SWEEP_DESTINATION=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com

# Optional egress proxy (http(s)://user:pass@host:port). Binance answers 451
# to US egress — including the spot testnet — so if your Lit environment
# egresses from the US, point this at a non-US authenticated proxy; the action
# then routes venue calls through the in-TEE Lit.Actions.proxiedFetch op
# (plan D4). Leave blank when egress is already venue-acceptable.
VENUE_PROXY_URL=


# ===========================================================================
# Auto-filled — leave blank, the scripts will populate them
# ===========================================================================

# Scoped usage key with execute permission for this example's group.
# Heads up: shown ONCE by the server. Re-running setup mints a fresh key
# and overwrites this line.
LIT_USAGE_API_KEY=

# Group + action CIDs — bookkeeping filled in by setup.js.
GROUP_ID=
REQUEST_ACTION_CID=
COMPLETE_ACTION_CID=

# The pending sweep — written by request-sweep.js, consumed by complete-sweep.js.
APPROVAL_ID=
SWEEP_AMOUNT=
SWEEP_ASSET=
