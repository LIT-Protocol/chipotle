# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints (add_group, add_action, create_wallet) that reject scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# EOA used to deploy the settlement + test-token contracts. Needs gas on
# whatever chain you're targeting (Base Sepolia by default).
DEPLOYER_PRIVATE_KEY=

# A hosted Postgres that exposes an HTTP SQL API (the Lit Action queries it
# over fetch — it cannot open a raw Postgres TCP socket). Neon's "SQL over
# HTTP" is the default target; see DB_HTTP_PROVIDER below. Put the full
# connection string here. `npm run setup` ENCRYPTS this against the vault PKP
# and stores only the ciphertext (ENCRYPTED_DATABASE_URL) — the action
# decrypts it inside the TEE at runtime and never returns it.
#
# Orders are stored as CIPHERTEXT only — no plaintext order data (side, price,
# quantity) ever touches this database.
DATABASE_URL=

# Which HTTP-SQL provider the action talks to: "neon" or "postgrest".
DB_HTTP_PROVIDER=neon


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com

# Hardhat networks for the deploy step
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
DEPLOY_NETWORK=baseSepolia

# Where the orchestrator talks to the deployed contracts.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# The single trading pair this demo runs. Plaintext routing metadata in
# Postgres (everything about the order itself stays encrypted).
PAIR=BASE/QUOTE

# Hard cap on orders matched per epoch. Phase-0 spike showed ~2.9ms/order
# in-enclave decrypt with no ceiling at 200; 200 is a conservative default.
MAX_BATCH=200


# ===========================================================================
# Auto-filled by `npm run setup` — leave blank, the script populates them
# ===========================================================================

# IPFS CIDs of the two actions.
ENCRYPT_ACTION_CID=
MATCH_ACTION_CID=

# Vault PKP wallet address (= pkpId) that encrypts/decrypts orders AND the
# DB connection string.
VAULT_PKP_ADDRESS=

# DATABASE_URL encrypted against the vault PKP. This is the only form of the
# connection string the action ever sees; it decrypts it inside the TEE.
ENCRYPTED_DATABASE_URL=

# Wallet address derived from the MATCH action's CID. The settlement
# contract pins this as the matcher whose signatures it trusts.
MATCH_ACTION_ADDRESS=

# Group binding {vault PKP, both action CIDs} and the scoped usage key the
# orchestrator uses to run the actions.
GROUP_ID=
LIT_USAGE_API_KEY=

# Deployed contract addresses.
BASE_TOKEN_ADDRESS=
QUOTE_TOKEN_ADDRESS=
SETTLEMENT_ADDRESS=
