# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_group and /add_action that reject scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# Your Hyperliquid TESTNET master account's private key (32-byte hex).
# Used exactly once, by `npm run approve-agent`, to sign the approveAgent
# grant — it never goes anywhere near the Lit API or the action.
#
#   *** TESTNET ONLY. Never put a mainnet key here. ***
#
# Make a throwaway:  node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
# then fund it with mock-USDC at https://app.hyperliquid-testnet.xyz/drip
# (connect the wallet in the testnet app first; the faucet funds the
# connected address, and Hyperliquid ignores accounts it has never seen
# funds for).
HL_MASTER_PRIVATE_KEY=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com


# ===========================================================================
# Auto-filled — leave blank, the scripts will populate them
# ===========================================================================

# Scoped usage key with execute permission for this example's group.
# Heads up: shown ONCE by the server. Re-running setup mints a fresh key
# and overwrites this line.
LIT_USAGE_API_KEY=

# Group + action CID — bookkeeping filled in by setup.js.
GROUP_ID=
ACTION_IPFS_CID=

# The agent wallet's address: derived from the action's CID inside the TEE.
# There is no corresponding key file anywhere — that's the point.
AGENT_ADDRESS=

# The master account's 0x address — derived from HL_MASTER_PRIVATE_KEY by
# approve-agent.js; trade.js passes it to the action as the account to
# trade for.
HL_MASTER_ADDRESS=
