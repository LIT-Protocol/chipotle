# ---------------------------------------------------------------------------
# You provide these.
# ---------------------------------------------------------------------------

# Account-level (master) Lit API key from https://dashboard.chipotle.litprotocol.com
# Setup calls management endpoints (/add_group, /create_wallet, /add_action)
# that reject scoped usage keys.
LIT_API_KEY=

# An EOA with Base Sepolia gas. Deploys the contracts and acts as the issuer
# operator that submits signed state updates. Get testnet ETH from a Base
# Sepolia faucet.
DEPLOYER_PRIVATE_KEY=

# Ethereum mainnet Alchemy URL — where the Chainalysis sanctions oracle lives.
# Form: https://eth-mainnet.g.alchemy.com/v2/<your-key>
# The action hard-codes a hostname whitelist requiring eth-mainnet.g.alchemy.com.
SCREENING_RPC_URL=

# Demo-only KYC signing key. Stands in for a real KYC provider (Persona/Sumsub)
# that would sign an attestation JWT after verifying a user's identity. The
# `mint` flow verifies a JWT signed by this key. Any random 32-byte hex works
# for the demo; generate one with:  openssl rand -hex 32
KYC_SIGNER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Defaults — fine to leave as-is for a Base Sepolia demo.
# ---------------------------------------------------------------------------
LIT_API_BASE=https://api.chipotle.litprotocol.com
DEPLOY_NETWORK=baseSepolia
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ---------------------------------------------------------------------------
# Written by `npm run setup` — leave blank.
# ---------------------------------------------------------------------------
LEDGER_PKP_ADDRESS=
KYC_SIGNER_ADDRESS=
ACTION_IPFS_CID=
ACTION_WALLET_ADDRESS=
DISCLOSE_ACTION_IPFS_CID=
GROUP_ID=
LIT_USAGE_API_KEY=
MOCK_USDC_ADDRESS=
PRIVUSD_ADDRESS=
