# ===========================================================================
# REQUIRED — fill in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you created
# the account, not a scoped usage key. Setup calls management endpoints
# (create_wallet, add_group, ...) that revert NotMasterAccount on scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# EOA that deploys the vault and pays gas to call exec(). Needs gas on the
# target chain (Base Sepolia by default). Note: exec() is permissionless —
# anyone can submit a valid MPC signature — so this is just the gas payer.
DEPLOYER_PRIVATE_KEY=
EXECUTOR_PRIVATE_KEY=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com

# Hardhat networks for deploy
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Where sign.js talks to the vault — should match where you deployed it.
RPC_URL=https://sepolia.base.org


# ===========================================================================
# Auto-filled by the scripts — leave blank
# ===========================================================================

# PKP minted by setup; the Encrypt/Decrypt boundary that seals the action's
# MPC session + keyshare to its CID.
MPC_PKP_ADDRESS=

# Scoped usage key with execute permission for this example's group.
# keygen.js / sign.js use this for /lit_action. Shown ONCE; re-running setup
# mints a fresh key.
LIT_USAGE_API_KEY=

# Written by keygen.js: the shared public key and its derived EVM address.
# The deployed vault pins VAULT_SIGNER_ADDRESS as its signer.
MPC_PUBLIC_KEY=
VAULT_SIGNER_ADDRESS=

# Written by deploy.js.
VAULT_ADDRESS=
