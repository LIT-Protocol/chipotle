# Lit Chipotle ---------------------------------------------------------------
LIT_API_BASE=https://api.chipotle.litprotocol.com

# Your ACCOUNT-LEVEL (master) API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_action that revert NotMasterAccount on scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com (saved when the
# account was created — if you've lost it, you'll need a new account).
LIT_API_KEY=

# Scoped usage key — auto-generated by setup.js with execute permission
# for this example's group. transfer.js sends /lit_action requests with
# this key. The master LIT_API_KEY above can't execute /lit_action for
# your own groups; only a scoped usage key can.
# Heads up: this key is shown ONCE by the server, so deleting it from
# .env means setup has to create a brand new one.
LIT_USAGE_API_KEY=

# Wallet address derived from the action's IPFS CID. This is what the
# deployed CompliantToken trusts as its compliance oracle. Editing the
# action source produces a new CID and therefore a new address — old
# deployments stop accepting signatures from the new action.
ACTION_WALLET_ADDRESS=

# Chainalysis screening ------------------------------------------------------
# The action's trust anchor is "we're talking to Alchemy's Ethereum
# mainnet endpoint." It hardcodes a hostname whitelist for
# eth-mainnet.g.alchemy.com — passing any other host (including
# public RPCs) returns `{ authorized: false }` without making the call.
# Get a free Alchemy app: https://dashboard.alchemy.com (Ethereum
# Mainnet); the URL looks like:
#   https://eth-mainnet.g.alchemy.com/v2/<your-api-key>
#
# To use a different provider (Infura / QuickNode / your own node), or
# to screen on a different mainnet where Chainalysis is deployed,
# edit ALLOWED_SCREENING_HOST in action/complianceGate.js. That mints
# a new action CID + signer address — you'll need to re-run setup and
# redeploy the CompliantToken.
SCREENING_RPC_URL=

# Contract deploy ------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
TOKEN_NAME=Compliant USD
TOKEN_SYMBOL=cUSD
INITIAL_SUPPLY=1000000

# Filled in after deploy
COMPLIANT_TOKEN_ADDRESS=
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# Transfer-time --------------------------------------------------------------
SENDER_PRIVATE_KEY=
