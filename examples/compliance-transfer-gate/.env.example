# ===========================================================================
# REQUIRED — fill these in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you first
# created the account, not a scoped usage key. Setup calls management
# endpoints like /add_action that revert NotMasterAccount on scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com (saved when the
# account was created — if you've lost it, you'll need a new account).
LIT_API_KEY=

# Alchemy Ethereum-mainnet RPC URL. The action enforces a hostname
# whitelist requiring eth-mainnet.g.alchemy.com — public RPCs and other
# providers won't pass. Get a free Alchemy app at
# https://dashboard.alchemy.com. The URL looks like:
#   https://eth-mainnet.g.alchemy.com/v2/<your-api-key>
SCREENING_RPC_URL=

# EOA used to deploy the CompliantToken. Needs gas on whatever chain
# you're targeting (Base Sepolia by default).
DEPLOYER_PRIVATE_KEY=

# EOA used by transfer.js to send compliance-gated transfers. Typically
# the same as DEPLOYER_PRIVATE_KEY for testing.
SENDER_PRIVATE_KEY=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com

# Hardhat networks for the deploy step
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Token constructor args (used by scripts/deploy.js)
TOKEN_NAME=Compliant USD
TOKEN_SYMBOL=cUSD
INITIAL_SUPPLY=1000000

# Where transfer.js talks to the CompliantToken — should match wherever
# you deployed it.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org


# ===========================================================================
# Auto-filled by `npm run setup` — leave blank, the script will populate them
# ===========================================================================

# Wallet address derived from the action's IPFS CID. The deployed
# CompliantToken pins this as its compliance oracle.
ACTION_WALLET_ADDRESS=

# Scoped usage key with execute permission for this example's group.
# transfer.js uses this for /lit_action — the master LIT_API_KEY above
# can't execute /lit_action for your own groups.
# Heads up: shown ONCE by the server. Re-running setup mints a fresh key
# and overwrites this line.
LIT_USAGE_API_KEY=

# Deployed CompliantToken contract address.
COMPLIANT_TOKEN_ADDRESS=
