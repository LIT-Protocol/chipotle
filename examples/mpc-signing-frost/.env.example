# ===========================================================================
# REQUIRED — fill in before running `npm run setup`
# ===========================================================================

# Your ACCOUNT-LEVEL (master) Lit API key — the one issued when you created
# the account, not a scoped usage key. Setup calls management endpoints
# (create_wallet, add_group, ...) that revert NotMasterAccount on scoped keys.
# Get it from https://dashboard.chipotle.litprotocol.com.
LIT_API_KEY=

# A funded Solana keypair (base58 secret key, as exported by `solana-keygen`
# or Phantom) used ONLY to fund the MPC address with a little SOL and to pay
# the fee-payer slot of the transfer. The MPC key itself never needs gas held
# elsewhere — but a brand-new account has no SOL, so this seeds it.
# On devnet you can also `solana airdrop` to the MPC address instead.
FUNDER_SECRET_KEY=


# ===========================================================================
# Defaults — change only if you know why
# ===========================================================================

LIT_API_BASE=https://api.chipotle.litprotocol.com

# Solana cluster the sign script talks to.
SOLANA_RPC_URL=https://api.devnet.solana.com


# ===========================================================================
# Auto-filled by the scripts — leave blank
# ===========================================================================

# PKP minted by setup; the Encrypt/Decrypt boundary that seals the action's
# MPC session + signing share to its CID.
MPC_PKP_ADDRESS=

# Scoped usage key with execute permission for this example's group.
# keygen.js / sign.js use this for /lit_action. Shown ONCE; re-running setup
# mints a fresh key.
LIT_USAGE_API_KEY=

# Written by keygen.js: the group Ed25519 public key (hex) and the Solana
# address (base58) it maps to. The FROST group key IS the Solana account.
MPC_PUBLIC_KEY=
SOLANA_ADDRESS=
