# ── Deploy (Phala Cloud) ──────────────────────────────────────────────────────
# used by `just deploy` to deploy to Phala Cloud: private key for DstackApp (Onchain KMS on Base).
# not required for local dev
PHALA_PRIVATE_KEY=0xdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# ── lit-api-server runtime ────────────────────────────────────────────────────
# All optional. In production these are set as (encrypted) env vars on the
# Phala CVM via docker-compose.phala.yml; locally, local_test.sh runs without
# any of them (billing disabled, default thresholds).

# Tracing filter (default: trace). Per-module overrides live in
# lit-api-server/log_levels.toml.
#RUST_LOG=info

# OTLP gRPC endpoint — required only when built with `--features otlp`.
#LIT_TELEMETRY_ENDPOINT=http://localhost:4317

# Override the dstack simulator socket path (dev builds only; the
# `production` feature hardcodes /var/run/dstack.sock).
#DSTACK_SOCKET=/tmp/dstack-sim/dstack.sock

# Override the Base chain RPC URL (falls back to rpc-config.yaml / built-in).
#BASE_CHAIN_RPC=https://mainnet.base.org

# Stripe billing. Both must be set or billing is disabled (no charges, no 402s).
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_PUBLISHABLE_KEY=pk_test_...

# Credits (in cents) granted to every new account at creation, so the
# quickstart works before adding funds. 0 or unset = no grant.
# Only meaningful when Stripe billing is enabled.
#STARTER_CREDITS_CENTS=0

# CPU load-shedding thresholds (see core/v1/guards/cpu_overload.rs).
#CPU_OVERLOAD_MULTIPLIER=2.0
#CPU_PSI_THRESHOLD=50.0
